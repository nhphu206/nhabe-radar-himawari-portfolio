# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src \
    NHABE_DATA_ROOT=/data \
    NHABE_FORECAST_MANIFEST=/artifacts/forecast_pairs.csv \
    NHABE_NORMALIZATION=/artifacts/normalization.json \
    NHABE_MODEL_CONFIG=/app/configs/model.yaml \
    NHABE_CHECKPOINT=/models/best_model.pt \
    NHABE_INFERENCE_OUTPUT=/app/output \
    NHABE_DEVICE=cpu

WORKDIR /app

COPY requirements-forecasting.txt requirements-api.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --prefer-binary -r requirements-api.txt \
    && python -m pip install --prefer-binary \
       --index-url https://download.pytorch.org/whl/cpu torch==2.14.1

# The image contains source/configuration only. Data and checkpoint are runtime mounts.
COPY LICENSE NOTICE.md README.md ./
COPY src/ ./src/
COPY configs/model.yaml ./configs/model.yaml
COPY scripts/20_create_synthetic_api_fixture.py ./scripts/20_create_synthetic_api_fixture.py

RUN groupadd --gid 10002 forecast \
    && useradd --uid 10002 --gid forecast --create-home forecast \
    && mkdir -p /app/output \
    && chown -R forecast:forecast /app/output \
    && python -m compileall -q /app/src \
    && python -m compileall -q /app/scripts \
    && python -c "import fastapi, torch, uvicorn; import nhabe_forecasting.api"

USER forecast

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3).read()" || exit 1

# One worker prevents duplicate model copies and serializes inference through the app lock.
CMD ["uvicorn", "nhabe_forecasting.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
