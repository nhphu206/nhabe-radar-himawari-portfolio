# Only files needed to install/run/test the pipeline enter the build context.
**
!Dockerfile
!.dockerignore
!requirements.txt
!pyproject.toml
!README.md
!src/
!src/**
!scripts/
!scripts/**
!tests/
!tests/**
!configs/
!configs/pipeline.yaml

# Exclude private material and caches even inside an allowed directory.
**/.git
**/__pycache__
**/*.py[cod]
**/.env
**/.env.*
**/*.pem
**/*.key
**/credentials*.json
**/*.log
**/*.part
**/*.tmp
**/report
**/handoff
**/secrets
**/.aws
**/checkpoints
**/models
**/*.npz
**/*.npy
**/*.bz2
**/*.RAW*
**/*.pdf
**/*.tex
**/*.zip
**/*.ckpt
**/*.pt
**/*.pth
